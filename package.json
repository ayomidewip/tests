{
  "name": "app-base-tests",
  "version": "1.0.0",
  "description": "Test suite for App Base API",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:app": "vitest run server/app.test.js",
